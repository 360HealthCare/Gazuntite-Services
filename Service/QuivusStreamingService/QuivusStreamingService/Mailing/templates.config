<?xml version="1.0" encoding="utf-8" ?>


<!--

  IMPORTANT: Don't forget to add this key in the AppSettings section
  of your configuration file (App.config / web.config) and make
  sure the config file and templates are present.
  
	<appSettings>
    <add key="Evolve.TemplateConfiguration" value="templates.config" />
  </appSettings>

-->


<!--
  Root element with an optional base directory. Any relative
  links for templates will be calculated relative to this folder.
-->
<TemplateConfiguration>

  <!--
    Optional base folder for templates with relative path settings.
  -->
  <BaseDirectory>Mailing</BaseDirectory>

  <!--
    Add this value to explicitely set this server (recommended in most times).
  -->
  <SmtpServer>host.quivus.com</SmtpServer>

  <Groups>
    <!--
      Every template needs to have a unique id. The type attribute
      defines whether mails should be 'Text' or 'Html.
    -->
    <!--<TemplateGroup TemplateGroupId="LocationSetup" Sender="support@quivus.com" MailFormat="Text">
      <Templates>
        --><!--   
            You can set the language attribute of the default template
            for your own information but it's not needed (and ignored)
            by the framework.
          --><!--
        <Template Locale="en" IsDefault="true">
          <Subject>Location Setup</Subject>
          --><!-- File paths can be absolute or relative. --><!--
          <File>templates/LocationSetup.txt</File>
        </Template>
      </Templates>
    </TemplateGroup>

    <TemplateGroup TemplateGroupId="AddLocationRequest" Sender="support@quivus.com" MailFormat="Text">
      <Templates>
        --><!--   
            You can set the language attribute of the default template
            for your own information but it's not needed (and ignored)
            by the framework.
          --><!--
        <Template Locale="en" IsDefault="true">
          <Subject>Location Setup</Subject>
          --><!-- File paths can be absolute or relative. --><!--
          <File>templates/AddLocationRequestEmailToOwner.txt</File>
        </Template>
      </Templates>
    </TemplateGroup>

    <TemplateGroup TemplateGroupId="AddLocationRequestApproved" Sender="support@quivus.com" MailFormat="Text">
      <Templates>
        --><!--   
            You can set the language attribute of the default template
            for your own information but it's not needed (and ignored)
            by the framework.
          --><!--
        <Template Locale="en" IsDefault="true">
          <Subject>Location Request Approved</Subject>
          --><!-- File paths can be absolute or relative. --><!--
          <File>templates/AddLocationRequestApproved.txt</File>
        </Template>
      </Templates>
    </TemplateGroup>

