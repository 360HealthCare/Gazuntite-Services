  <loggingConfiguration name="Logging Application Block" tracingEnabled="true" defaultCategory="Info" logWarningsWhenNoCategoriesMatch="true">
    <listeners>
      <add  header="----------------------------------------"
        footer="----------------------------------------" fileName=".\log\QuivusManagerService.log" rollSizeKB="1024" timeStampPattern="yyyy-MM-dd" rollFileExistsBehavior="Increment" rollInterval="Day" formatter="Text Formatter"  listenerDataType="Microsoft.Practices.EnterpriseLibrary.Logging.Configuration.RollingFlatFileTraceListenerData, Microsoft.Practices.EnterpriseLibrary.Logging, Version=5.0.414.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" traceOutputOptions="Timestamp" type="Microsoft.Practices.EnterpriseLibrary.Logging.TraceListeners.RollingFlatFileTraceListener, Microsoft.Practices.EnterpriseLibrary.Logging, Version=5.0.414.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" name="Rolling Flat File Trace Listener" />
      <add  header="----------------------------------------"
        footer="----------------------------------------" fileName=".\log\QuivusManagerService.log" rollSizeKB="1024" timeStampPattern="yyyy-MM-dd" rollFileExistsBehavior="Increment" rollInterval="Day" formatter="Text Formatter"  listenerDataType="Microsoft.Practices.EnterpriseLibrary.Logging.Configuration.RollingFlatFileTraceListenerData, Microsoft.Practices.EnterpriseLibrary.Logging, Version=5.0.414.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" traceOutputOptions="Timestamp" type="Microsoft.Practices.EnterpriseLibrary.Logging.TraceListeners.RollingFlatFileTraceListener, Microsoft.Practices.EnterpriseLibrary.Logging, Version=5.0.414.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" name="Log Errors Rolling Flat File Trace Listener" />
      <add  header="----------------------------------------"
        footer="----------------------------------------" fileName=".\log\QuivusManagerService_Error.log" rollSizeKB="1024" timeStampPattern="yyyy-MM-dd" rollFileExistsBehavior="Increment" rollInterval="Day" formatter="Text Formatter"  listenerDataType="Microsoft.Practices.EnterpriseLibrary.Logging.Configuration.RollingFlatFileTraceListenerData, Microsoft.Practices.EnterpriseLibrary.Logging, Version=5.0.414.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" traceOutputOptions="Timestamp" type="Microsoft.Practices.EnterpriseLibrary.Logging.TraceListeners.RollingFlatFileTraceListener, Microsoft.Practices.EnterpriseLibrary.Logging, Version=5.0.414.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" name="Error Handler" />
      <add  header="----------------------------------------"
        footer="----------------------------------------" fileName=".\log\QuivusManagerService_Debug.log" rollSizeKB="1024" timeStampPattern="yyyy-MM-dd" rollFileExistsBehavior="Increment" rollInterval="Day" formatter="Text Formatter"  listenerDataType="Microsoft.Practices.EnterpriseLibrary.Logging.Configuration.RollingFlatFileTraceListenerData, Microsoft.Practices.EnterpriseLibrary.Logging, Version=5.0.414.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" traceOutputOptions="Timestamp" type="Microsoft.Practices.EnterpriseLibrary.Logging.TraceListeners.RollingFlatFileTraceListener, Microsoft.Practices.EnterpriseLibrary.Logging, Version=5.0.414.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" name="Debug Handler" />
      <add  header="----------------------------------------"
        footer="----------------------------------------" fileName=".\log\QuivusManagerService.log" rollSizeKB="1024" timeStampPattern="yyyy-MM-dd" rollFileExistsBehavior="Increment" rollInterval="Day" formatter="Text Formatter"  listenerDataType="Microsoft.Practices.EnterpriseLibrary.Logging.Configuration.RollingFlatFileTraceListenerData, Microsoft.Practices.EnterpriseLibrary.Logging, Version=5.0.414.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" traceOutputOptions="Timestamp" type="Microsoft.Practices.EnterpriseLibrary.Logging.TraceListeners.RollingFlatFileTraceListener, Microsoft.Practices.EnterpriseLibrary.Logging, Version=5.0.414.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" name="WebServices category Rolling Flat File Trace Listener" />
    </listeners>
    <formatters>
      <add  template="Machine: {machine},{newline}Timestamp: {keyvalue(Time)},{newline}Category: {category},{newline}Severity: {severity},{newline}Message: {message},{newline}Exception: {keyvalue(Exception)}...." type="Microsoft.Practices.EnterpriseLibrary.Logging.Formatters.TextFormatter, Microsoft.Practices.EnterpriseLibrary.Logging, Version=5.0.414.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35"
       name="Text Formatter" >
      </add>
      <!--   <add  template="Timestamp: {timestamp}{newline}Message: {message}{newline}Category: {category}{newline}Priority: {priority}{newline}EventId: {eventid}{newline}Severity: {severity}{newline}Title: {title}{newline}Activity ID: {property(ActivityId)}{newline}Machine: {localMachine}{newline}App Domain: {localAppDomain}{newline}ProcessId: {localProcessId}{newline}Process Name: {localProcessName}{newline}Thread Name: {threadName}{newline}Win32 ThreadId:{win32ThreadId}{newline}Extended Properties: {dictionary({key} - {value}{newline})}" 
            name="Text Formatter">
      </add>-->
    </formatters>



    <logFilters>
      <add enabled="true" type="Microsoft.Practices.EnterpriseLibrary.Logging.Filters.LogEnabledFilter, Microsoft.Practices.EnterpriseLibrary.Logging, Version=5.0.414.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" name="LogEnabled Filter" />
    </logFilters>
    <categorySources>
      <!-- Posible "SwitchValue" values are 
            All,
            Off,
            Critical,
            Error,
            Warning,
            Information,
            Verbose (corresponds to Logger.Debug methods)
      -->
      <!-- General category..If no category is specified all logs go inside here-->
      <add switchValue="Information" name="Info">
        <listeners>
          <add name="Rolling Flat File Trace Listener" />
        </listeners>
      </add>
      <!-- Configure for UI category Source-->
      <add switchValue="Error" name="Error">
        <listeners>
          <add name="Error Handler" />
        </listeners>
      </add>
      <add switchValue="Verbose" name="Debug">
        <listeners>
          <add name="Debug Handler" />
        </listeners>
      </add>
      <!-- Configure for Web Services category Source
      <add switchValue="All" name="WebServices">
        <listeners>
          <add name="WebServices category Rolling Flat File Trace Listener" />
        </listeners>
      </add>-->
    </categorySources>
    <specialSources>
      <!-- All events.. Includes unspecified categories..In this case any category other than "General" will take the value here
            Note: The SwitchValue here takes precedence over the "switchValues" in the category Sources. So if you had Warning here, and 
            "Information" in one of the SwitchVaues before(for example: "Repoting" category Source, then 
            "Information" source for Reporting Category will not be logged!-->
      <allEvents switchValue="All" name="All Events">
        <listeners>
          <add name="Rolling Flat File Trace Listener" />
        </listeners>
      </allEvents>
      <!-- Unprocessed categories..We dont have that issue..by defaut everything goes to General-->
      <notProcessed switchValue="All" name="Unprocessed Category">
        <listeners>
          <add name="Rolling Flat File Trace Listener" />
        </listeners>
      </notProcessed>
      <!-- Errors encountered in the Logger. These will be logged go to a different file. THis ensures that if there is a probem with the main logfile used for logging,
           we can find out by lokking at this file-->
      <errors switchValue="All" name="Logging Errors &amp; Warnings">
        <listeners>
          <add name="Log Errors Rolling Flat File Trace Listener" />
        </listeners>
      </errors>
    </specialSources>
  </loggingConfiguration>

  
  <system.web>
    <compilation debug="true">
      <assemblies>
        <add assembly="System.Core, Version=3.5.0.0, Culture=neutral, PublicKeyToken=B77A5C561934E089" />
        <add assembly="System.Web.Extensions, Version=3.5.0.0, Culture=neutral, PublicKeyToken=31BF3856AD364E35" />
      </assemblies>
    </compilation>
  </system.web>
  
  <system.serviceModel>
    <services>
      <service name="QuivusManagerService.QuivusManagerService.ManagerService.QuivusManagerService"
            behaviorConfiguration="QuivusManagerDebugServiceBehavior">

        <endpoint name="QuivusManagerService"
                  binding="basicHttpBinding"
                  bindingConfiguration="QuivusManagerDebugServiceBinding"
                  contract="QuivusManagerService.QuivusManagerService.ManagerService.IQuivusManagerService" />

        <endpoint contract="IMetadataExchange" binding="mexHttpBinding" address="mex" />
      </service>
      
      
    </services>

    <client>
      <endpoint address="http://192.168.0.63:84/Service/AddressBookService.svc"
          binding="basicHttpBinding" bindingConfiguration="QuivusManagerService"
          contract="AddressBookService.IAddressBookService" name="QuivusManagerService" />
      <endpoint address="http://192.168.0.63:83/Service/UserManagerService.svc"
                binding="basicHttpBinding" bindingConfiguration="UserManagerDebugService"
                contract="UserManagerService.IUserManagerService" name="UserManagerDebugService" />
      <endpoint address="http://192.168.0.63:83/Service/StreamingService.svc"
          binding="basicHttpBinding" bindingConfiguration="StreamedService"
          contract="StreamingService.IStreamingService" name="StreamedService" />

      <endpoint address="http://192.168.0.63:85/Service/VisitService.svc"
               binding="basicHttpBinding" bindingConfiguration="BasicHttpBinding_IVisitService"
               contract="VisitService.IVisitService" name="BasicHttpBinding_IVisitService" />
    </client>
    
    <bindings>
      <basicHttpBinding>
        <binding name="QuivusManagerDebugServiceBinding">
          <security mode="None">
            <message clientCredentialType="UserName"/>
          </security>
        </binding>

        <binding name="UserManagerDebugService" closeTimeout="00:11:00"
                   openTimeout="00:10:00" receiveTimeout="00:10:00" sendTimeout="00:11:00"
                   allowCookies="false" bypassProxyOnLocal="false" hostNameComparisonMode="StrongWildcard"
                   maxBufferSize="2147483647" maxBufferPoolSize="2147483647" maxReceivedMessageSize="2147483647"
                   messageEncoding="Text" textEncoding="utf-8" transferMode="Buffered"
                   useDefaultWebProxy="true">
          <readerQuotas maxDepth="2147483647" maxStringContentLength="2147483647" maxArrayLength="2147483647"
              maxBytesPerRead="2147483647" maxNameTableCharCount="2147483647" />
          <security mode="None">
            <transport clientCredentialType="None" proxyCredentialType="None"
                realm="" />
            <message clientCredentialType="UserName" algorithmSuite="Default" />
          </security>
        </binding>

        <binding name="QuivusManagerService" closeTimeout="00:11:00"
                 openTimeout="00:11:00" receiveTimeout="00:10:00" sendTimeout="00:11:00"
                 allowCookies="false" bypassProxyOnLocal="false" hostNameComparisonMode="StrongWildcard"
                 maxBufferSize="2147483647" maxBufferPoolSize="2147483647" maxReceivedMessageSize="2147483647"
                 messageEncoding="Text" textEncoding="utf-8" transferMode="Buffered"
                 useDefaultWebProxy="true">
          <readerQuotas maxDepth="2147483647" maxStringContentLength="2147483647" maxArrayLength="2147483647"
              maxBytesPerRead="2147483647" maxNameTableCharCount="2147483647" />
          <security mode="None">
            <transport clientCredentialType="None" proxyCredentialType="None"
                realm="" />
            <message clientCredentialType="UserName" algorithmSuite="Default" />
          </security>
        </binding>
        
        <binding name="StreamedService" closeTimeout="00:11:00" openTimeout="00:11:00"
            receiveTimeout="00:10:00" sendTimeout="00:11:00" allowCookies="false"
            bypassProxyOnLocal="false" hostNameComparisonMode="StrongWildcard"
            maxBufferSize="2147483647" maxBufferPoolSize="2147483647" maxReceivedMessageSize="2147483647"
            messageEncoding="Mtom" textEncoding="utf-8" transferMode="Buffered"
            useDefaultWebProxy="true">
          <readerQuotas maxDepth="2147483647" maxStringContentLength="2147483647" maxArrayLength="2147483647"
              maxBytesPerRead="2147483647" maxNameTableCharCount="2147483647" />
          <security mode="None">
            <transport clientCredentialType="None" proxyCredentialType="None"
                realm="" />
            <message clientCredentialType="UserName" algorithmSuite="Default" />
          </security>
        </binding>

        <binding name="BasicHttpBinding_IVisitService" closeTimeout="00:01:00"
                   openTimeout="00:01:00" receiveTimeout="00:10:00" sendTimeout="00:01:00"
                   allowCookies="false" bypassProxyOnLocal="false" hostNameComparisonMode="StrongWildcard"
                   maxBufferSize="2147483647" maxBufferPoolSize="2147483647" maxReceivedMessageSize="2147483647"
                   messageEncoding="Text" textEncoding="utf-8" transferMode="Buffered"
                   useDefaultWebProxy="true">
          <readerQuotas maxDepth="2147483647" maxStringContentLength="2147483647" maxArrayLength="2147483647"
              maxBytesPerRead="2147483647" maxNameTableCharCount="2147483647" />
          <security mode="None">
            <transport clientCredentialType="None" proxyCredentialType="None"
                realm="" />
            <message clientCredentialType="UserName" algorithmSuite="Default" />
          </security>
        </binding>
        
      </basicHttpBinding>
    </bindings>
    
    <behaviors>
      <serviceBehaviors>
        <behavior name="QuivusManagerDebugServiceBehavior">
          <serviceMetadata httpGetEnabled="true" />
          <serviceDebug includeExceptionDetailInFaults="true" />
          <dataContractSerializer maxItemsInObjectGraph="6553600" />
        </behavior>
        
      </serviceBehaviors>
    </behaviors>
    <serviceHostingEnvironment multipleSiteBindingsEnabled="true" />
  </system.serviceModel>
  
 <system.webServer>
   <modules runAllManagedModulesForAllRequests="true" />
   <directoryBrowse enabled="true" />
   <!--<modules runAllManagedModulesForAllRequests="true"/>-->
  </system.webServer>

  <appSettings>
    <add key="Evolve.TemplateConfiguration" value="Mailing/templates.config" />

  </appSettings>
</configuration>
